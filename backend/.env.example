# Database - from Neon dashboard, direct connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Auth
JWT_SECRET=<run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))">
JWT_EXPIRES_IN=7d

# CORS - set to your Vercel frontend URL after deploying
CORS_ORIGIN=https://not-lify.vercel.app

# Public backend URL - used when returning uploaded image URLs
PUBLIC_API_URL=https://my-notes-ihcp.onrender.com

# File uploads - local backend storage path
UPLOAD_DIR=uploads

# Redis - optional, from Upstash free tier
REDIS_URL=

# Google OAuth - required for Google sign-in
GOOGLE_CLIENT_ID=
